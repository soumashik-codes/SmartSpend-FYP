SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend-domain.vercel.app
DATABASE_URL=sqlite:///./smartspend.db
# Example Railway Postgres URL:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:PORT/DBNAME
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GROQ_API_KEY=
ENABLE_LLM_CATEGORIZER=true
ENABLE_ADVISOR_NARRATIVE=true
ADVISOR_LLM_MODEL=openai/gpt-oss-20b
